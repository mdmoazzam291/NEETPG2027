# NEETPG2027 backend configuration
# Copy to a local/deployment environment. Never commit real secrets.

# Core app
NEETPG2027_DATABASE_URL=sqlite:///instance/neetpg2027.sqlite3
NEETPG2027_MEDIA_ROOT=instance/media

# Allow the GitHub Pages frontend to call the AI gateway.
# Add other trusted origins as a comma-separated list when needed.
NEETPG2027_CORS_ORIGINS=https://mdmoazzam291.github.io

# NeuralVault AI gateway protection.
# Generate a long random value and enter the same value in NeuralVault Provider setup.
NEETPG2027_AI_ACCESS_TOKEN=
NEETPG2027_AI_MAX_REQUESTS_PER_MINUTE=30
NEETPG2027_AI_TIMEOUT_SECONDS=45

# OpenAI. Set both key and model to enable the provider.
NEETPG2027_OPENAI_API_KEY=
NEETPG2027_OPENAI_MODEL=

# Google Gemini. Set both key and model to enable the provider.
NEETPG2027_GEMINI_API_KEY=
NEETPG2027_GEMINI_MODEL=

# Anthropic Claude. Set both key and model to enable the provider.
NEETPG2027_ANTHROPIC_API_KEY=
NEETPG2027_ANTHROPIC_MODEL=

# Optional private/local OpenAI-compatible server.
# Example base URL for a LAN/local server: http://127.0.0.1:1234
NEETPG2027_OPENAI_COMPATIBLE_BASE_URL=
NEETPG2027_OPENAI_COMPATIBLE_MODEL=
NEETPG2027_OPENAI_COMPATIBLE_API_KEY=
